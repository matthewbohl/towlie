[Unit]
Description=Towel Bar Wi-Fi Controller Agent
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=towelbar
Group=towelbar
Environment=TOWELBAR_CONFIG=/etc/towelbar-agent/config.yaml
ExecStart=/opt/towelbar-agent/venv/bin/towelbar-agent --config /etc/towelbar-agent/config.yaml run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/towelbar-agent

[Install]
WantedBy=multi-user.target
